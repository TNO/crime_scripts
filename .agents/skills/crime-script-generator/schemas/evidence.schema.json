{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tno.nl/crime-script-generator/evidence.schema.json",
  "title": "Crime script evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sources", "claims"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "title",
          "kind",
          "state",
          "contentHash",
          "reliability",
          "passages"
        ],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "existingId": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["web", "local"] },
          "state": { "enum": ["valid", "needs-review", "orphaned", "invalid"] },
          "url": { "type": "string", "format": "uri" },
          "filename": { "type": "string", "minLength": 1 },
          "publisher": { "type": "string" },
          "authors": { "type": "string" },
          "literatureType": { "type": "integer", "minimum": 1, "maximum": 15 },
          "publicationDate": { "type": "string" },
          "accessedAt": { "type": "string" },
          "contentHash": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
          "reliability": { "type": "string", "minLength": 1 },
          "secondaryHistorical": { "type": "boolean" },
          "passages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["text"],
              "properties": {
                "text": { "type": "string", "minLength": 1 },
                "locator": { "type": "string" }
              }
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "web" } }, "required": ["kind"] },
            "then": { "required": ["url", "accessedAt"] }
          },
          {
            "if": { "properties": { "kind": { "const": "local" } }, "required": ["kind"] },
            "then": { "required": ["filename"] }
          }
        ]
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nodeKey", "sourceKeys"],
        "properties": {
          "nodeKey": { "type": "string", "minLength": 1 },
          "sourceKeys": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "note": { "type": "string" },
          "state": {
            "enum": [
              "valid",
              "needs-review",
              "orphaned",
              "invalid",
              "unsubstantiated-after-human-edit"
            ]
          }
        }
      }
    }
  }
}
