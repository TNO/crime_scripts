{
  "name": "crime_scrips",
  "version": "0.0.1",
  "description": "GUI for creating and editing crime scene scripts",
  "scripts": {
    "clean": "rimraf ./dist",
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "build:domain": "npm run clean && npm run build",
    "icons:optimize": "pnpm dlx svgo@4.0.0 --config svgo.config.mjs --folder public/icons --recursive",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mithril",
    "materialize-css",
    "typescript"
  ],
  "license": "MIT",
  "app": "src/app.ts",
  "target": "web",
  "dependencies": {
    "@crime-script/core": "workspace:*",
    "docx": "^9.7.2",
    "file-saver": "^2.0.5",
    "lz-string": "^1.5.0",
    "material-icons": "^1.13.14",
    "meiosis-setup": "^6.2.3",
    "mithril": "^2.3.8",
    "mithril-materialized": "4.0.0",
    "mithril-ui-form": "^2.3.3",
    "stopwords-en": "^0.3.0",
    "stopwords-nl": "^0.3.0",
    "translate.js": "^1.3.2",
    "wasm-stemmers": "^0.1.0"
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@types/materialize-css": "^1.0.15",
    "@types/mithril": "^2.2.9",
    "dotenv": "18.0.4",
    "rimraf": "^6.1.3",
    "sass": "^1.105.0",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-wasm": "^3.6.0"
  }
}
